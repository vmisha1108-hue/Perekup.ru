  auto draft=session->state;require(perekup::nativeTutorialAction(draft,"start",2,[&](const Json& s){session->commit(s);}),"Saved resume step");{perekup::Session restored(std::filesystem::u8path(root.toUtf8().constData()),citiesById,carsById,homeCity);require(restored.load().status==perekup::LoadStatus::Loaded&&perekup::nativeTutorialProgress(restored.state)["step"]==2,"Resume after reload");}
