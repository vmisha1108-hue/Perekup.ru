// Native layouts matched to the approved desktop application references.
 void travelApp(){
 auto body=new QWidget;auto layout=new QVBoxLayout(body);layout->setSpacing(18);
 auto here=new QLabel(QStringLiteral("Вы сейчас"));here->setObjectName("muted");layout->addWidget(here);auto location=new QLabel;location->setObjectName("heading");layout->addWidget(location);auto line=new QFrame;line->setFrameShape(QFrame::HLine);layout->addWidget(line);
 auto row=new QHBoxLayout;auto label=new QLabel(QStringLiteral("Куда поедем?"));label->setStyleSheet("font-size:16px;font-weight:600");row->addWidget(label);auto target=new QComboBox;target->setObjectName("travelDestination");for(const auto& city:catalog.at("cities"))target->addItem(qs(city.value("name",""))+" · "+qs(city.value("region","")),qs(city.value("id","")));row->addWidget(target,1);layout->addLayout(row);auto status=new QLabel;status->setWordWrap(true);status->setObjectName("muted");layout->addWidget(status);
 auto routes=new QWidget;auto grid=new QGridLayout(routes);grid->setContentsMargins(0,0,0,0);grid->setSpacing(16);layout->addWidget(routes);layout->addStretch();
 auto refresh=[this,body,location,target,status,routes,grid]{if(!session||!session->ready())return;const auto& state=session->state;const auto& transport=state.at("transport");auto city=transport.at("cityId").get<std::string>();auto destination=target->currentData().toString().toStdString();location->setText(qs(citiesById.at(city).value("name","")));bool moving=!transport.at("trip").is_null();target->setEnabled(!moving);if(moving){const auto& trip=transport.at("trip");status->setText(QStringLiteral("В пути до ")+qs(citiesById.at(trip.at("to").get<std::string>()).value("name",""))+QStringLiteral(". Прибытие: ")+QDateTime::fromMSecsSinceEpoch(qint64(perekup::num(trip,"arrivesAt"))).toString("dd.MM HH:mm"));}else status->setText(city==destination?QStringLiteral("Вы уже в этом городе."):QStringLiteral("Цены и маршруты — игровые оценки с учётом расстояния, пересадок и отдыха. В пути продолжают идти время, платежи и встречи."));
 auto revision=qs(city)+"/"+qs(destination)+"/"+QString::number(moving)+"/"+QString::number(qint64(perekup::num(state,"balance")));if(routes->property("revision").toString()==revision)return;routes->setProperty("revision",revision);while(auto item=grid->takeAt(0)){delete item->widget();delete item;}if(!citiesById.contains(destination))return;int index=0;for(const auto& option:perekup::routeOptions(citiesById.at(city),citiesById.at(destination),false)){auto card=new QFrame;card->setObjectName("routeCard");auto col=new QVBoxLayout(card);col->setContentsMargins(18,18,18,18);col->setSpacing(14);auto title=new QLabel(qs(option.value("label","")));title->setStyleSheet("font-size:16px");col->addWidget(title);auto price=new QLabel(money(perekup::num(option,"price")));price->setObjectName("routePrice");col->addWidget(price);auto minutes=qint64(perekup::num(option,"duration")/60000);auto duration=new QLabel(QStringLiteral("Время в пути: %1 д %2 ч").arg(minutes/1440).arg((minutes%1440)/60));duration->setWordWrap(true);col->addWidget(duration);auto mode=option.value("mode","");auto description=new QLabel(mode=="train"?QStringLiteral("С пересадками при необходимости. Самый недорогой общественный транспорт."):mode=="plane"?QStringLiteral("Дорога в аэропорт и регистрация включены."):QStringLiteral("Поездка по дороге с учётом остановок и отдыха."));description->setObjectName("muted");description->setWordWrap(true);col->addWidget(description,1);auto depart=button(QStringLiteral("Поехать за ")+money(perekup::num(option,"price")));depart->setObjectName("travelDepart-"+qs(mode));depart->setEnabled(!moving&&perekup::num(state,"balance")>=perekup::num(option,"price"));col->addWidget(depart);connect(depart,&QPushButton::clicked,body,[this,target,mode,routes]{try{auto draft=session->state;if(!perekup::departPublicTransport(draft,citiesById,carsById,homeCity,target->currentData().toString().toStdString(),mode)){showError(QStringLiteral("Поездка недоступна. Проверьте баланс и завершите текущую встречу."));return;}session->commit(draft);routes->setProperty("revision",QString());}catch(const std::exception& e){showError(QString::fromUtf8(e.what()));}});grid->addWidget(card,index/2,index%2);++index;}grid->setColumnStretch(0,1);grid->setColumnStretch(1,1);};
 connect(target,qOverload<int>(&QComboBox::currentIndexChanged),body,[refresh](int){refresh();});auto timer=new QTimer(body);connect(timer,&QTimer::timeout,body,refresh);timer->start(500);refresh();open("travel",QStringLiteral("Переезд"),body,QSize(820,700));
 }
 void calendarApp(){auto body=new QWidget;auto layout=new QVBoxLayout(body);layout->setSpacing(22);auto calendar=new OsCalendarView(QDateTime::fromMSecsSinceEpoch(gameClock.gameMs).date());calendar->setObjectName("monthCalendar");layout->addWidget(calendar);auto line=new QFrame;line->setFrameShape(QFrame::HLine);layout->addWidget(line);auto title=new QLabel(QStringLiteral("Ближайшие встречи"));title->setObjectName("heading");title->setStyleSheet("font-size:15px");layout->addWidget(title);auto agenda=new QLabel;agenda->setObjectName("calendarAgenda");agenda->setWordWrap(true);layout->addWidget(agenda);auto meetings=button(QStringLiteral("Открыть встречи"));meetings->setProperty("secondary",true);layout->addWidget(meetings,0,Qt::AlignLeft);connect(meetings,&QPushButton::clicked,this,[this]{meetingsApp();});auto refresh=[this,calendar,agenda]{if(!session||!session->ready())return;calendar->setEnglish(preferences.value("language").toString("ru")=="en");calendar->setToday(QDateTime::fromMSecsSinceEpoch(gameClock.gameMs).date());QStringList entries;for(const auto& pending:session->state.at("pending")){if(pending.value("type","")!="meet")continue;auto date=QDateTime::fromMSecsSinceEpoch(pending.at("when").get<qint64>());auto key=std::to_string(pending.at("carId").get<perekup::Money>());entries<<date.toString("dd.MM HH:mm")+" · "+(carsById.contains(key)?qs(carsById[key].value("name","")):QString())+" · "+qs(pending.at("npc").value("name",""));}agenda->setText(entries.isEmpty()?QStringLiteral("Ближайших встреч нет. Договоритесь о цене и назначьте встречу в переписке."):entries.join("\n"));};auto timer=new QTimer(body);connect(timer,&QTimer::timeout,body,refresh);timer->start(1000);refresh();layout->addStretch();open("calendar",QStringLiteral("Календарь"),body,QSize(820,700));}
 void clock(){
 auto body=new QWidget;auto l=new QVBoxLayout(body);l->setContentsMargins(22,20,22,24);l->setSpacing(12);
 auto analog=new OsClockFace;analog->setFixedHeight(180);l->addWidget(analog);auto face=new QLabel;face->setObjectName("clockTime");face->setAlignment(Qt::AlignCenter);face->setStyleSheet("font-size:36px;color:#147d74");l->addWidget(face);
 auto date=new QLabel;date->setAlignment(Qt::AlignCenter);date->setWordWrap(true);l->addWidget(date);
 auto note=new QLabel(QStringLiteral("1 игровая минута = 5 реальных секунд.\nВо время игры в змейку время идёт вдвое быстрее."));note->setWordWrap(true);note->setAlignment(Qt::AlignCenter);note->setObjectName("muted");l->addWidget(note);
 auto duration=new QComboBox;duration->setObjectName("sleepHours");l->addWidget(new QLabel(QStringLiteral("Сколько поспать")));l->addWidget(duration);
 auto sleep=button(QStringLiteral("Поспать"));sleep->setObjectName("sleepUntilMorning");l->addWidget(sleep);
 auto status=new QLabel;status->setObjectName("sleepStatus");status->setWordWrap(true);status->setAlignment(Qt::AlignCenter);l->addWidget(status);
 auto canSleep=[this]{if(!session||!session->ready()||closing||runtimeFailed||collectorDialogOpen)return false;const auto& s=session->state;return s.at("transport").at("trip").is_null()&&!(s.contains("chat")&&s["chat"].is_object()&&s["chat"].value("met",false)&&!s["chat"].value("done",false))&&s.at("marketRisks").at("seizures").size()<5;};
 auto update=[this,analog,face,date,sleep,status,duration,canSleep]{
  auto now=QDateTime::fromMSecsSinceEpoch(gameClock.gameMs);analog->value=now.time();analog->update();face->setText(now.toString("HH:mm"));date->setText(QLocale(preferences.value("language").toString("ru")=="en"?QLocale::English:QLocale::Russian).toString(now.date(),QLocale::LongFormat));
  int cap=perekup::maximumSleepHours(now.time().hour());if(duration->property("cap").toInt()!=cap){int previous=duration->count()?duration->currentData().toInt():cap==8?8:2;QSignalBlocker block(duration);duration->clear();for(int h=1;h<=cap;++h)duration->addItem(QStringLiteral("%1 ч").arg(h),h);duration->setCurrentIndex(duration->findData(std::clamp(previous,1,cap)));duration->setProperty("cap",cap);}
  bool allowed=canSleep();sleep->setEnabled(allowed);duration->setEnabled(allowed);sleep->setText(QStringLiteral("Поспать %1 ч").arg(duration->currentData().toInt()));status->setText(allowed?(cap==8?QStringLiteral("Ночной отдых: до 8 часов. Сообщения продолжат приходить."):QStringLiteral("Дневной отдых: до 3 часов. Сообщения продолжат приходить.")):QStringLiteral("Сначала завершите поездку, встречу или разговор с коллекторами."));
 };
 connect(duration,qOverload<int>(&QComboBox::currentIndexChanged),body,[update](int){update();});
 connect(sleep,&QPushButton::clicked,body,[this,duration,canSleep,update]{if(!canSleep())return;try{
  auto draft=session->state;auto current=QDateTime::fromMSecsSinceEpoch(gameClock.gameMs);auto target=gameClock.gameMs+qint64(perekup::boundedSleepHours(current.time().hour(),duration->currentData().toInt()))*3600000;auto hooks=runtimeHooks();bool interrupted=false;
  while(draft.at("gameMs").get<qint64>()<target){auto next=std::min<qint64>(target,draft.at("gameMs").get<qint64>()+15*60000);perekup::tickRuntime(draft,next,citiesById,carsById,offersById,homeCity,hooks);if((draft["bank"].contains("collectors")&&!draft["bank"]["collectors"]["call"].is_null())||draft["marketRisks"]["seizures"].size()>=5){interrupted=true;break;}}
  session->commit(draft);gameClock.gameMs=draft.at("gameMs").get<qint64>();gameClock.lastRealMs=QDateTime::currentMSecsSinceEpoch();syncCareerMarket();refreshTopPanel();update();if(windows.count("market"))renderMarket();if(interrupted)collectorCall();
 }catch(const std::exception& e){showError(QString::fromUtf8(e.what()));}});
 auto timer=new QTimer(body);connect(timer,&QTimer::timeout,body,update);update();timer->start(250);auto scroll=new QScrollArea;scroll->setWidgetResizable(true);scroll->setFrameShape(QFrame::NoFrame);scroll->setWidget(body);open("clock",QStringLiteral("Часы"),scroll,QSize(440,650));
 }
