 void applyOsTheme(){bool dark=preferences.value("theme").toString("dark")=="dark";qApp->setProperty("osDark",dark);auto chosen=preferences.value("island").toObject().value("accent").toString("#8be0c7");QColor accent(chosen);if(!accent.isValid())accent=QColor("#8be0c7");if(!dark)accent=accent.darker(175);qApp->setProperty("osAccent",accent);qApp->setStyleSheet(osStyleSheet()+osThemeCss(dark,accent.name())+osBubbleCss(dark)+QString("QComboBox::down-arrow{image:url(\"%1\");width:12px;height:8px;}").arg(QDir::fromNativeSeparators(root+"/assets/ui/chevron-down.png")));osThemeInlineWidgets(dark);desktop->viewport()->update();}
 void addThemeSettings(QVBoxLayout* layout,QWidget* body){auto theme=new QComboBox;theme->setObjectName("osThemeChoice");theme->addItem(QStringLiteral("Светлая"),"light");theme->addItem(QStringLiteral("Тёмная"),"dark");theme->setCurrentIndex(theme->findData(preferences.value("theme").toString("dark")));layout->addWidget(theme);connect(theme,qOverload<int>(&QComboBox::currentIndexChanged),body,[this,theme]{auto previous=preferences;preferences["theme"]=theme->currentData().toString();if(!savePreferences()){preferences=previous;showError(QStringLiteral("Не удалось сохранить тему."));return;}applyOsTheme();});auto wallpaperRow=new QHBoxLayout;for(const auto& pair:std::vector<std::pair<QString,QString>>{{QStringLiteral("Набережная"),"assets/wallpapers/embankment.webp"},{QStringLiteral("Сияние"),"assets/wallpapers/ribbons.jpg"}}){auto preview=new QToolButton;preview->setText(pair.first);preview->setIcon(QIcon(root+"/"+pair.second));preview->setIconSize(QSize(100,60));preview->setToolButtonStyle(Qt::ToolButtonTextUnderIcon);preview->setFixedSize(118,92);wallpaperRow->addWidget(preview);connect(preview,&QToolButton::clicked,body,[this,path=pair.second]{auto previous=preferences;preferences["wallpaper"]=path;if(!savePreferences()){preferences=previous;showError(QStringLiteral("Не удалось сохранить обои."));return;}desktop->setWallpaper(root+"/"+path);});}wallpaperRow->addStretch();layout->addLayout(wallpaperRow);}
 void refreshTopPanel(){if(!time)return;time->setText(QDateTime::fromMSecsSinceEpoch(gameClock.gameMs).toString("HH:mm"));if(island)island->setClock(time->text());if(dockTime)dockTime->setText(QDateTime::fromMSecsSinceEpoch(gameClock.gameMs).toString("dd.MM HH:mm"));if(session&&session->ready()){auto city=session->state["transport"].value("cityId",homeCity);topCity->setText(QStringLiteral("")+(citiesById.contains(city)?qs(citiesById.at(city).value("name","")):qs(city)));topBalance->setText((adminUnlocked?QStringLiteral("⚡ "):QString())+money(perekup::num(session->state,"balance")));}else{topCity->clear();topBalance->clear();}}
 void helpApp(){auto body=new QWidget;auto layout=new QVBoxLayout(body);auto title=new QLabel(QStringLiteral("Справка Perekyp"));title->setObjectName("heading");layout->addWidget(title);auto text=new QLabel(QStringLiteral("Покупайте автомобили на авторынке, договаривайтесь о цене в переписке и назначайте встречу. На встрече осмотрите машину и подпишите договор. Купленная машина появится в гараже; там доступны ремонт и продажа.\n\nЧетыре буквы подписи нужно вводить по памяти. Напоминание стоит 10 000 ₽.\n\nКредиты и действующие долги находятся в Банке. Коллекторы подключаются после 30 дней просрочки.\n\nЧасы показывают игровое время. Ускорение ×2 работает только во время активной игры в змейку.\n\nПеред поездкой проверьте город продавца и время встречи. Документы по завершённым сделкам сохраняются в приложении «Документы»."));text->setWordWrap(true);layout->addWidget(text);auto tutorial=button(QStringLiteral("Повторить обучение"));layout->addWidget(tutorial,0,Qt::AlignLeft);connect(tutorial,&QPushButton::clicked,this,[this]{startTutorial(0);});layout->addStretch();open("help",QStringLiteral("Справка"),body,QSize(640,600));}
