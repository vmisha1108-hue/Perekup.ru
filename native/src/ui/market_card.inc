 QFrame* createMarketCard(const Json& car){
 auto card=new MarketCard;auto outer=new QVBoxLayout(card);outer->setContentsMargins(1,1,1,1);outer->setSpacing(0);auto key=std::to_string(car.at("id").get<perekup::Money>());auto path=photoOverrides.value(key,car.value("img",""));auto photo=new CarPhotoView(root+"/assets/"+qs(path),photoCrops.value(path,Json()),640,false);photo->setObjectName("marketPhoto");photo->setProperty("marketPhoto",true);outer->addWidget(photo);card->setPhoto(photo);
