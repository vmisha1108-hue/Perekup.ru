 bool isPinnedTask(const QString& id)const{return QStringList{"market","garage","calendar","calc","clock","settings"}.contains(id);}
 void addDockTask(const QString& id,const QString& title){auto b=new OsTaskButton;b->setObjectName("task-"+id);b->setProperty("taskButton",true);b->setProperty("pinned",isPinnedTask(id));b->setCursor(Qt::PointingHandCursor);b->setIcon(osIcon(id));b->setIconSize(QSize(24,24));b->setFixedSize(39,42);b->setToolTip(title);b->setAccessibleName(title);taskButtons[id]=b;auto bar=qobject_cast<QHBoxLayout*>(dock->layout());if(dockToolsSeparator)bar->insertWidget(bar->indexOf(dockToolsSeparator),b);else bar->addWidget(b);connect(b,&QPushButton::clicked,this,[this,id]{auto it=windows.find(id);if(it==windows.end()){launchApp(id);return;}if(it->second->isVisible()&&desktop->activeSubWindow()==it->second){osMinimizeWindow(it->second);updateTaskbar();}else launchApp(id);});}
 void updateTaskbar(){if(!dock)return;auto bar=qobject_cast<QHBoxLayout*>(dock->layout());for(const auto& entry:windows)if(!taskButtons.count(entry.first))addDockTask(entry.first,entry.second->windowTitle());for(auto it=taskButtons.begin();it!=taskButtons.end();){auto b=it->second;auto found=windows.find(it->first);bool running=found!=windows.end();if(!running&&!isPinnedTask(it->first)){bar->removeWidget(b);b->deleteLater();it=taskButtons.erase(it);continue;}b->setProperty("running",running);b->setProperty("active",running&&found->second->isVisible()&&desktop->activeSubWindow()==found->second);b->style()->unpolish(b);b->style()->polish(b);b->update();++it;}positionDock();}
