 void purchaseSmokeTest(){try{
 auto require=[](bool value,const char* text){if(!value)throw std::runtime_error(text);};const auto baseline=perekup::tutorialPurchaseIds(session->state);
 require(!perekup::tutorialPurchaseCompleted(session->state,baseline),"Guide waits for a new signed purchase");
 Json car;for(const auto& candidate:catalog["cars"])if(candidate.value("cityId","")==homeCity&&candidate.value("price",0LL)>0&&candidate.value("price",0LL)<100000){car=candidate;break;}require(car.is_object(),"Local test car");auto draft=session->state;perekup::nativeAdminMoney(draft,"set",1000000,[](const Json&){});session->commit(draft);QTimer chatDriver;int phase=0;connect(&chatDriver,&QTimer::timeout,this,[&]{auto dialog=qobject_cast<QDialog*>(QApplication::activeModalWidget());if(!dialog)return;if(dialog->objectName()=="carDetails"){require(dialog->findChild<QWidget*>("listingPhoto"),"Details photo exists");auto shot=qEnvironmentVariable("PEREKUP_PURCHASE_SCREENSHOT");if(!shot.isEmpty())dialog->grab().save(shot+"-details.png");dialog->findChild<QPushButton*>("contactSeller")->click();return;}if(dialog->objectName()!="dealChat")return;auto stage=session->state["chat"].value("stage","");qInfo()<<"Purchase driver"<<phase<<qs(stage);if(phase==0){dialog->findChild<QLineEdit*>("chatMessage")->setText(QStringLiteral("Здравствуйте"));dialog->findChild<QPushButton*>("chatSend")->click();require(session->state["chat"]["log"].size()>=2,"Chat messages persist");phase=1;return;}if(stage=="talk"){for(auto input:dialog->findChildren<QLineEdit*>())if(input->placeholderText()==QStringLiteral("Предложить цену, ₽"))input->setText(QString::number(car.at("price").get<perekup::Money>()+1000));for(auto b:dialog->findChildren<QPushButton*>())if(b->text()==QStringLiteral("Предложить цену")){b->click();break;}return;}if(stage=="schedule"){if(session->state["chat"].contains("busyTimes"))for(auto combo:dialog->findChildren<QComboBox*>()){auto when=combo->currentData().toLongLong();for(const auto& busy:session->state["chat"]["busyTimes"])if(busy==when){combo->setCurrentIndex(combo->currentIndex()+1);break;}}for(auto b:dialog->findChildren<QPushButton*>())if(b->text()==QStringLiteral("Назначить встречу")){b->click();break;}return;}if(stage=="go"){if(phase==1){auto next=session->state;auto when=perekup::num(next["chat"]["meet"],"whenMs");require(when>0,"Meeting timestamp exists");for(auto& pending:next["pending"])pending["noShow"]=false;next["gameMs"]=perekup::Money(when);session->commit(next);gameClock.gameMs=perekup::Money(when);gameClock.lastRealMs=QDateTime::currentMSecsSinceEpoch();phase=2;}auto go=dialog->findChild<QPushButton*>("goMeeting");if(go&&go->isEnabled())go->click();}});chatDriver.start(100);carDetails(car);chatDriver.stop();require(phase==2&&session->state["chat"].value("stage","")=="waiting","Detail to chat to scheduled arrival");require(windows.count("meetings"),"Meeting view opens");
 auto advance=[&](const char* field){auto next=session->state;auto id=next["chat"].value("pid","");perekup::Money target=0;for(const auto& item:next["pending"])if(item.value("id","")==id)target=perekup::num(item["flow"],field);require(target>0,"Flow timer exists");next["gameMs"]=target;gameClock.gameMs=target;gameClock.lastRealMs=QDateTime::currentMSecsSinceEpoch();auto hooks=runtimeHooks();hooks.meeting(next);session->commit(next);for(auto timer:windows["meetings"]->findChildren<QTimer*>())QMetaObject::invokeMethod(timer,"timeout",Qt::DirectConnection);};advance("arrivalAt");require(session->state["chat"].value("stage","")=="inspection","Inspection stage");{auto next=session->state;next["marketRisks"]["vehicles"][std::to_string(car.at("id").get<perekup::Money>())]=perekup::rollMarketRisk(car,[]{return .9;});session->commit(next);}auto picker=windows["meetings"]->findChild<QPushButton*>("meetingPicker");require(picker&&picker->isEnabled(),"Professional inspection button");auto moneyBefore=session->state["balance"].get<perekup::Money>();picker->click();require(session->state["balance"].get<perekup::Money>()==moneyBefore-3000,"Inspection charged once");auto risk=session->state["marketRisks"]["vehicles"];picker->click();require(session->state["balance"].get<perekup::Money>()==moneyBefore-3000&&session->state["marketRisks"]["vehicles"]==risk,"Repeated inspection preserves result and money");advance("inspectionUntil");require(session->state["chat"].value("stage","")=="event","Decision stage");
 QTimer signer;connect(&signer,&QTimer::timeout,this,[&]{auto dialog=qobject_cast<QDialog*>(QApplication::activeModalWidget());if(!dialog||dialog->objectName()!="purchaseContract")return;for(auto b:dialog->findChildren<QPushButton*>())if(b->text()==QStringLiteral("Заполнить по игровым документам")){b->click();break;}auto signature=dialog->findChild<QLineEdit*>("contract-signature");require(signature,"Manual contract signature field");signature->setText("TEST");dialog->findChild<QCheckBox*>()->setChecked(true);auto shot=qEnvironmentVariable("PEREKUP_PURCHASE_SCREENSHOT");if(!shot.isEmpty())dialog->grab().save(shot+"-contract.png");QTimer::singleShot(150,this,[]{if(auto box=qobject_cast<QMessageBox*>(QApplication::activeModalWidget()))box->accept();});for(auto b:dialog->findChildren<QPushButton*>())if(b->text()==QStringLiteral("Подписать ДКП")){b->click();break;}});signer.start(100);windows["meetings"]->findChild<QPushButton*>("meetingContract")->click();signer.stop();require(std::find(session->state["garage"].begin(),session->state["garage"].end(),car.at("id"))!=session->state["garage"].end(),"Purchased car appears in garage");require(!session->state["contracts"]["records"].empty(),"Signed DKP is stored");require(perekup::tutorialPurchaseCompleted(session->state,baseline),"New signed purchase completes the guide");qInfo()<<"Purchase GUI passed: photo/details, chat/message, price, scheduling, arrival, wait, inspection, paid inspection once, decision, manual DKP signature, garage and records";QTimer::singleShot(100,this,[this]{close();});
 }catch(const std::exception& e){qWarning()<<"Purchase GUI failed:"<<e.what();QApplication::exit(71);}}
