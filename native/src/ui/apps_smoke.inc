 launchApp("calc");auto calc=windows.at("calc");for(const QString key:{"7","+","3","="})for(auto b:calc->findChildren<QPushButton*>())if(b->text()==key){b->click();break;}require(calc->findChild<QLabel*>("calcDisplay")->text()=="10","Calculator evaluates button input");snapshot("calc");closeApp("calc");
