# Скопируйте в .env. Файл .env не публикуется и не передаётся браузеру.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_API_BASE_URL=https://api.openai.com/v1
HOST=127.0.0.1
PORT=8000
# Для сервера отдельно от GitHub Pages: точный origin без пути и без / в конце.
# ALLOWED_ORIGINS=https://vmisha1108-hue.github.io
# Лимит запросов на сервер за сутки (в памяти, сбрасывается при перезапуске).
AI_DAILY_LIMIT=200
